@model CICDTrg.Models.AppUser
@{
    ViewData["Title"] = "Change Password";
}

<div class="header">
    <div class="title">
        <h1>Change Password for @Model.Username</h1>
        <p>Update the security credentials for this user</p>
    </div>
</div>

<form asp-controller="Settings" asp-action="ChangePassword" method="post" class="deploy-panel" style="margin-bottom: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: end;">
    <input type="hidden" name="id" value="@Model.Id" />
    
    @if (ViewBag.Error != null)
    {
        <div style="grid-column: span 2; color: var(--danger); padding: 10px; background: rgba(255,59,48,0.1); border-radius: 6px; border: 1px solid rgba(255,59,48,0.2);">
            @ViewBag.Error
        </div>
    }
    
    @if (ViewBag.Success != null)
    {
        <div style="grid-column: span 2; color: var(--success); padding: 10px; background: rgba(52,199,89,0.1); border-radius: 6px; border: 1px solid rgba(52,199,89,0.2);">
            @ViewBag.Success
        </div>
    }

    <div class="form-group" style="margin-bottom:0;">
        <label>New Password</label>
        <input type="password" name="newPassword" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
    </div>

    <div class="form-group" style="margin-bottom:0;">
        <label>Confirm New Password</label>
        <input type="password" name="confirmPassword" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
    </div>

    <div class="form-group" style="grid-column: span 2; margin-top:10px;">
        <button type="submit" class="btn" style="width: 100%; padding: 14px;">Force Update Password</button>
    </div>
</form>

<div style="margin-top: 20px;">
    <a href="/Settings" class="btn" style="background: transparent; border: 1px solid var(--border-color); color: var(--text-muted);">&larr; Back to Settings</a>
</div>
