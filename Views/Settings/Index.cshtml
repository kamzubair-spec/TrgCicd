@model List<CICDTrg.Models.AppUser>
@{
    ViewData["Title"] = "Settings";
}

<div class="header">
    <div class="title">
        <h1>User Management</h1>
        <p>Manage access to DeployHub</p>
    </div>
</div>

<h2 class="section-title">Add New User</h2>
<form asp-controller="Settings" asp-action="CreateUser" method="post" class="deploy-panel" style="margin-bottom: 40px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; align-items: end;">
    <div class="form-group" style="margin-bottom:0;">
        <label>Username</label>
        <input type="text" name="username" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
    </div>
    <div class="form-group" style="margin-bottom:0;">
        <label>Password</label>
        <input type="password" name="password" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
    </div>
    <div class="form-group" style="margin-bottom:0;">
        <label>Role</label>
        <select name="role" style="width:100%;">
            <option value="Admin">Admin</option>
            <option value="User">User</option>
        </select>
    </div>
    <div class="form-group" style="grid-column: span 3; margin-top:10px;">
        <button type="submit" class="btn" style="width: 100%; padding: 14px;">Create User</button>
    </div>
</form>

<h2 class="section-title">Active Users</h2>
<table class="jobs-table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th style="width: 1%; white-space: nowrap;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td><strong>@user.Username</strong></td>
                <td><span class="status-badge status-success">@user.Role</span></td>
                <td style="white-space: nowrap;">
                    <a href="/Settings/ChangePassword/@user.Id" class="btn" style="padding: 6px 12px; font-size: 13px; background: var(--primary); text-decoration: none; margin-right: 8px;">Change Password</a>
                    @if (user.Username != User.Identity?.Name)
                    {
                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" style="display:inline-block;" onsubmit="return confirm('Delete this user?');">
                            <button type="submit" class="btn" style="padding: 6px 12px; background: var(--danger); font-size: 13px;">Delete</button>
                        </form>
                    }
                    else
                    {
                        <span style="color: var(--text-muted); font-size: 13px;">(Current User)</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
