@model CICDTrg.Models.OrgConfiguration
@{
    ViewData["Title"] = "Edit Pipeline";
}

<div class="header">
    <div class="title">
        <a href="/OrgConfiguration" style="color: var(--primary); text-decoration: none; margin-bottom: 8px; display: inline-block;">&larr; Back to Pipelines</a>
        <h1>Edit Pipeline: @Model.Name</h1>
        <p>Update configuration settings for this deployment pipeline.</p>
    </div>
</div>

<form asp-controller="OrgConfiguration" asp-action="Edit" method="post" autocomplete="off" class="deploy-panel" style="margin-bottom: 40px; display: flex; flex-direction: column; gap: 20px; align-items: stretch;">
    <input type="hidden" name="Id" value="@Model.Id" />
    
    <!-- General -->
    <div class="form-group">
        <label>Pipeline Name</label>
        <input type="text" name="Name" value="@Model.Name" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
    </div>

    <!-- Salesforce Settings -->
    <div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; border: 1px solid var(--border-color);">
        <h3 style="margin-top:0; margin-bottom: 20px; font-size: 16px; color: var(--primary);">1. Target Org Settings</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
                <label>Org Type</label>
                <select name="OrgType" style="width:100%;">
                    <option value="Sandbox" selected="@(Model.OrgType == "Sandbox")">Sandbox</option>
                    <option value="Production" selected="@(Model.OrgType == "Production")">Production</option>
                </select>
            </div>
            <div class="form-group">
                <label>Instance URL</label>
                <input type="url" name="InstanceUrl" value="@Model.InstanceUrl" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            <div class="form-group">
                <label>Username</label>
                <input type="email" name="Username" value="@Model.Username" placeholder="s.zubair@org.com (Optional for Client Credentials)" autocomplete="off" style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            
            <div class="form-group">
                <label>Authentication Method</label>
                <select name="AuthMethod" style="width:100%;">
                    <option value="ClientCredentials" selected="@(Model.AuthMethod == "ClientCredentials")">Client Credentials (Consumer Secret)</option>
                    <option value="JWT" selected="@(Model.AuthMethod == "JWT")">JWT Bearer (Private .key File)</option>
                </select>
            </div>
            <div class="form-group">
                <label>Consumer Key (Client ID)</label>
                <input type="text" name="ClientId" value="@Model.ClientId" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            <div class="form-group">
                <label>Consumer Secret / Key File Path</label>
                <input type="password" name="EncryptedClientSecret" placeholder="(Leave blank to keep existing encrypted value)" autocomplete="new-password" style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
                <small style="color: var(--text-muted);">For JWT, enter the full path to the .key file instead.</small>
            </div>
        </div>
    </div>

    <!-- Bitbucket Settings -->
    <div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; border: 1px solid var(--border-color);">
        <h3 style="margin-top:0; margin-bottom: 20px; font-size: 16px; color: var(--success);">2. Source & Deployment Strategy</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
                <label>Repository URL (HTTPS or SSH)</label>
                <input type="text" name="RepoUrl" value="@Model.RepoUrl" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            <div class="form-group">
                <label>Source Branch to Pull</label>
                <input type="text" name="SourceBranch" value="@Model.SourceBranch" required style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            <div class="form-group">
                <label>Repo Username</label>
                <input type="text" name="EncryptedRepoUsername" autocomplete="new-password" placeholder="(Leave blank to keep existing encrypted value)" style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            <div class="form-group">
                <label>Repo App Password</label>
                <input type="password" name="EncryptedRepoAppPassword" autocomplete="new-password" placeholder="(Leave blank to keep existing encrypted value)" style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            
            <div class="form-group" style="grid-column: span 2;">
                <label>SSH Private Key Content</label>
                <textarea name="EncryptedSshKeyContent" placeholder="(Leave blank to keep existing encrypted SSH key)" rows="4" style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px; font-family: monospace;"></textarea>
                <small style="color: var(--text-muted);">Encrypted on save. Will be dynamically injected during git clone.</small>
            </div>

            <div class="form-group" style="margin-top:20px;">
                <label>Deployment Strategy</label>
                <div style="display:flex; gap: 10px; align-items: center; margin-top:10px;">
                    <input type="checkbox" name="IsCheckOnly" value="true" checked="@Model.IsCheckOnly" />
                    <span style="color: white; font-size: 14px;">Validate Only (Check Only)</span>
                </div>
            </div>
            <div class="form-group">
                <label>Test Level</label>
                <select name="TestLevel" style="width:100%;">
                    <option value="NoTestRun" selected="@(Model.TestLevel == "NoTestRun")">No Test Run</option>
                    <option value="RunLocalTests" selected="@(Model.TestLevel == "RunLocalTests")">Run Local Tests</option>
                    <option value="RunAllTestsInOrg" selected="@(Model.TestLevel == "RunAllTestsInOrg")">Run All Tests In Org</option>
                    <option value="RunSpecifiedTests" selected="@(Model.TestLevel == "RunSpecifiedTests")">Run Specified Tests</option>
                </select>
            </div>
            <div class="form-group">
                <label>Specified Tests (Comma Separated)</label>
                <input type="text" name="SpecifiedTestClasses" value="@Model.SpecifiedTestClasses" style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
            <div class="form-group">
                <label>Auto-Merge Target Branch (Post-Deploy)</label>
                <input type="text" name="AutoMergeTargetBranch" value="@Model.AutoMergeTargetBranch" style="width:100%; background: rgba(15,17,26,0.8); border: 1px solid var(--border-color); color: white; padding: 12px; border-radius: 8px;" />
            </div>
        </div>
    </div>

    <div class="form-group" style="margin-top:10px;">
        <button type="submit" class="btn" style="width: 100%; padding: 16px; font-size: 16px;">Save Changes</button>
    </div>
</form>
