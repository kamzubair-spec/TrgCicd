@model string
@{
    ViewData["Title"] = "AI PR Review";
}

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin:0;">Architect Review for PR #@ViewBag.PRId</h3>
        <button onclick="history.back()" class="btn btn-secondary" style="padding: 6px 12px; background-color: #f1f5f9; color: #334155; border: none; border-radius: 4px; font-size: 14px; font-weight: 500; cursor:pointer;">&larr; Back to List</button>
    </div>
    <div class="card-body">
        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; white-space: pre-wrap; font-family: 'Inter', sans-serif; line-height: 1.6; color: #334155;">
@Model
        </div>
    </div>
</div>
