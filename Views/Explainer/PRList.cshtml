@model IEnumerable<CICDTrg.Services.PRModel>
@{
    ViewData["Title"] = "Pull Requests";
}

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin:0;">Pull Requests for @ViewBag.SprintName</h3>
        <div>
            <a href="/Explainer/ListPRs?sprintName=@ViewBag.SprintName&workspace=@ViewBag.Workspace&repoSlug=@ViewBag.RepoSlug&status=@ViewBag.CurrentStatus&refresh=true" class="btn btn-secondary" onclick="this.style.pointerEvents='none'; this.innerHTML='<span class=\'custom-spinner\' style=\'border-color: #334155; border-top-color: transparent;\'></span> Refreshing...';" style="padding: 6px 12px; background-color: #e2e8f0; color: #334155; text-decoration: none; border-radius: 4px; font-size: 14px; font-weight: 500; margin-right: 8px; display: inline-flex; align-items: center; gap: 5px;">&#x21bb; Refresh Cache</a>
            <a href="/Explainer/PRReviewer" class="btn btn-secondary" style="padding: 6px 12px; background-color: #f1f5f9; color: #334155; text-decoration: none; border-radius: 4px; font-size: 14px; font-weight: 500;">&larr; Back</a>
        </div>
    </div>
    <div class="card-body">
        <div style="margin-bottom: 15px;">
            <form method="get" action="/Explainer/ListPRs" style="display: flex; align-items: center; gap: 10px;">
                <input type="hidden" name="sprintName" value="@ViewBag.SprintName" />
                <input type="hidden" name="workspace" value="@ViewBag.Workspace" />
                <input type="hidden" name="repoSlug" value="@ViewBag.RepoSlug" />
                <label for="statusFilter" style="font-family: 'Inter', sans-serif; font-size: 14px; color: #475569; font-weight: 500;">Filter by Status:</label>
                <select id="statusFilter" name="status" onchange="this.form.submit()" style="padding: 6px 12px; border: 1px solid #e2e8f0; border-radius: 4px; font-family: 'Inter', sans-serif; font-size: 14px; color: #334155; background-color: white;">
                    <option value="ALL" selected="@(ViewBag.CurrentStatus == "ALL" ? "selected" : null)">All</option>
                    <option value="OPEN" selected="@(ViewBag.CurrentStatus == "OPEN" ? "selected" : null)">Open</option>
                    <option value="DRAFT" selected="@(ViewBag.CurrentStatus == "DRAFT" ? "selected" : null)">Draft</option>
                    <option value="MERGED" selected="@(ViewBag.CurrentStatus == "MERGED" ? "selected" : null)">Merged</option>
                    <option value="DECLINED" selected="@(ViewBag.CurrentStatus == "DECLINED" ? "selected" : null)">Declined</option>
                </select>
            </form>
        </div>
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: 'Inter', sans-serif;">
            <thead>
                <tr style="border-bottom: 2px solid #e2e8f0;">
                    <th style="padding: 12px; color: #475569;">PR #</th>
                    <th style="padding: 12px; color: #475569; width: 25%; max-width: 300px;">Title</th>
                    <th style="padding: 12px; color: #475569; width: 20%;">Source</th>
                    <th style="padding: 12px; color: #475569;">Target</th>
                    <th style="padding: 12px; color: #475569;">Author</th>
                    <th style="padding: 12px; color: #475569;">Status</th>
                    <th style="padding: 12px; color: #475569;">Date</th>
                    <th style="padding: 12px; color: #475569; width: 10%; min-width: 140px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pr in Model)
                {
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 12px; font-weight: 600; font-size: 13px; color: white;">#@pr.Id</td>
                        <td style="padding: 12px; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; color: white;" title="@pr.Title">@pr.Title</td>
                        <td style="padding: 12px;"><span style="font-family: monospace; background: transparent; padding: 2px 6px; border: 1px solid #e2e8f0; border-radius: 4px; font-size: 12px;">@pr.SourceBranch</span></td>
                        <td style="padding: 12px;"><span style="font-family: monospace; background: transparent; padding: 2px 6px; border: 1px solid #e2e8f0; border-radius: 4px; font-size: 12px;">@pr.TargetBranch</span></td>
                        <td style="padding: 12px; font-size: 13px; color: white;">@pr.Author</td>
                        <td style="padding: 12px;">
                            @if (pr.State == "MERGED") { <span style="background: #dcfce7; color: #166534; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight:600;">@pr.State</span> }
                            else if (pr.State == "OPEN") { <span style="background: #dbeafe; color: #1e40af; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight:600;">@pr.State</span> }
                            else { <span style="background: #f1f5f9; color: #475569; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight:600;">@pr.State</span> }
                        </td>
                        <td style="padding: 12px; font-size: 13px; color: white;">@pr.CreatedOn.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 12px;">
                            <a href="javascript:void(0);" onclick="startReview(this, '/Explainer/ReviewPR?prId=@pr.Id&workspace=@ViewBag.Workspace&repoSlug=@ViewBag.RepoSlug')" style="display:inline-block; padding: 6px 12px; background-color: var(--primary); color: white; text-decoration: none; border-radius: 4px; font-size: 13px; font-weight: 500;">✨ Review PR</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" style="padding: 20px; text-align: center; color: #94a3b8;">No pull requests found in the selected timeframe.</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (ViewBag.TotalPages > 1)
        {
            <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center; font-family: 'Inter', sans-serif;">
                <div style="color: #64748b; font-size: 14px;">
                    Page <strong>@ViewBag.CurrentPage</strong> of <strong>@ViewBag.TotalPages</strong>
                </div>
                <div>
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a href="/Explainer/ListPRs?sprintName=@ViewBag.SprintName&page=@(ViewBag.CurrentPage - 1)&workspace=@ViewBag.Workspace&repoSlug=@ViewBag.RepoSlug&status=@ViewBag.CurrentStatus" class="btn btn-secondary" style="padding: 6px 12px; background-color: #f1f5f9; color: #334155; text-decoration: none; border-radius: 4px; font-size: 14px; font-weight: 500; margin-right: 8px;">Previous</a>
                    }
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a href="/Explainer/ListPRs?sprintName=@ViewBag.SprintName&page=@(ViewBag.CurrentPage + 1)&workspace=@ViewBag.Workspace&repoSlug=@ViewBag.RepoSlug&status=@ViewBag.CurrentStatus" class="btn btn-secondary" style="padding: 6px 12px; background-color: #f1f5f9; color: #334155; text-decoration: none; border-radius: 4px; font-size: 14px; font-weight: 500;">Next</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Review Progress Modal -->
<div id="reviewProgressModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.7); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; padding:30px; border-radius:12px; width:450px; font-family:'Inter',sans-serif; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
        <h4 style="margin-top:0; color:#1e293b; font-size: 18px; margin-bottom: 20px;">✨ Generating AI Review...</h4>
        
        <div id="step1" style="color:#334155; margin-top:15px; display:flex; align-items:center; gap:12px; font-size: 14px; font-weight: 500;">
            <span class="custom-spinner" style="width:18px; height:18px; border-width:2px; border-color:#3b82f6; border-top-color:transparent;"></span>
            <span>Fetching code diff from Bitbucket...</span>
        </div>
        
        <div id="step2" style="color:#cbd5e1; margin-top:15px; display:flex; align-items:center; gap:12px; font-size: 14px; font-weight: 500;">
            <span style="width:18px; height:18px; border-radius:50%; border:2px solid #cbd5e1; display:inline-block;"></span>
            <span>Analyzing code structure...</span>
        </div>
        
        <div id="step3" style="color:#cbd5e1; margin-top:15px; display:flex; align-items:center; gap:12px; font-size: 14px; font-weight: 500;">
            <span style="width:18px; height:18px; border-radius:50%; border:2px solid #cbd5e1; display:inline-block;"></span>
            <span>Applying Salesforce Architect rules...</span>
        </div>
        
        <div id="step4" style="color:#cbd5e1; margin-top:15px; display:flex; align-items:center; gap:12px; font-size: 14px; font-weight: 500;">
            <span style="width:18px; height:18px; border-radius:50%; border:2px solid #cbd5e1; display:inline-block;"></span>
            <span>Formatting review output...</span>
        </div>
    </div>
</div>

<script>
function startReview(btn, url) {
    btn.style.pointerEvents = 'none';
    btn.innerHTML = '<span class="custom-spinner"></span> Initializing...';

    document.getElementById('reviewProgressModal').style.display = 'flex';
    
    const step1 = document.getElementById('step1');
    const step2 = document.getElementById('step2');
    const step3 = document.getElementById('step3');
    const step4 = document.getElementById('step4');

    const checkIcon = `<svg style="width:20px;height:20px;color:#10b981;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
    const spinner = `<span class="custom-spinner" style="width:18px; height:18px; border-width:2px; border-color:#3b82f6; border-top-color:transparent;"></span>`;

    setTimeout(() => {
        step1.innerHTML = `${checkIcon} <span style="color:#10b981;">Code diff fetched</span>`;
        step2.innerHTML = `${spinner} <span style="color:#334155;">Analyzing code structure...</span>`;
    }, 1500);

    setTimeout(() => {
        step2.innerHTML = `${checkIcon} <span style="color:#10b981;">Analysis complete</span>`;
        step3.innerHTML = `${spinner} <span style="color:#334155;">Applying Salesforce Architect rules...</span>`;
    }, 3500);

    setTimeout(() => {
        step3.innerHTML = `${checkIcon} <span style="color:#10b981;">Rules applied</span>`;
        step4.innerHTML = `${spinner} <span style="color:#334155;">Formatting review output...</span>`;
    }, 6000);

    window.location.href = url;
}
</script>
